{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin": 0,
    "exclusive": true,

    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [],
    "modules-right": [
        "network",
        "custom/uptime",
        "wireplumber",
        "backlight",
        "battery",
        "clock#date",
        "clock#time",
        "custom/user"
    ],

    "sway/workspaces": {
        "format": "{name}",
        "disable-scroll": true,
        "disable-click": true,
        "all-outputs": false,
        "numeric-first": true
    },

    "sway/mode": {
        "format": "{}",
        "tooltip": false
    },

    "network": {
        "format-wifi":        "󰤨 {essid}",
        "format-ethernet":    "󰈀 eth",
        "format-disconnected": "󰤭 offline",
        "format-linked":      "󰈁 linked",
        "tooltip": false,
        "interval": 5
    },

    "custom/uptime": {
        "exec": "~/.config/waybar/scripts/uptime.sh",
        "format": "󰔟 {}",
        "interval": 60,
        "tooltip": false
    },

    "wireplumber": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰖁 muted",
        "tooltip": false,
        "on-click": "",
        "on-scroll-up": "",
        "on-scroll-down": ""
    },

    "backlight": {
        "format": "󰃞 {percent}%",
        "tooltip": false,
        "on-scroll-up": "",
        "on-scroll-down": ""
    },

    "battery": {
        "states": {
            "warning":  30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged":  "󰚥 {capacity}%",
        "format-icons":   ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": false,
        "interval": 30
    },

    "clock#date": {
        "format": "󰃭 {:%a %d %b}",
        "tooltip": false
    },

    "clock#time": {
        "format": "󰥔 {:%H:%M}",
        "tooltip": false
    },

    "custom/user": {
        "exec": "whoami",
        "format": " {}",
        "interval": "once",
        "tooltip": false
    }
}
